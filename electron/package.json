{
  "name": "cs-fantasy",
  "productName": "CS Fantasy Toolkit",
  "version": "0.1.120",
  "description": "Counter-Strike fantasy valuations, brackets and roster optimisation.",
  "homepage": "https://csfantasy.co.uk/",
  "author": "HenryAIvs",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "public": "cross-env HLTV_PUBLIC=1 electron .",
    "dev": "cross-env VITE_DEV_SERVER=true electron .",
    "renderer:dev": "vite",
    "renderer:build": "vite build",
    "app": "npm run renderer:build && electron .",
    "dist": "npm run renderer:build && electron-builder --win --publish never",
    "dist:dir": "npm run renderer:build && electron-builder --win --dir",
    "release": "npm run renderer:build && electron-builder --win --publish always",
    "postinstall": "node scripts/prune-lockfiles.cjs"
  },
  "build": {
    "appId": "uk.aivs.csfantasy",
    "productName": "CS Fantasy Toolkit",
    "artifactName": "CS-Fantasy-Toolkit-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "public-config.json",
      "package.json",
      "dist/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "sign": "./scripts/sign-windows.cjs",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "CS Fantasy Toolkit",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HenryWilliamsPersonal",
        "repo": "HLTV_Fantasy",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "allowScripts": {
    "electron@44.8.0": true
  },
  "overrides": {}
}
